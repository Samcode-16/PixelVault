# PixelVault Configuration Example
# Copy this file to your environment file (e.g. /etc/gallery.env on EC2 or .env for local testing)

# AWS & Storage
S3_BUCKET=your-secure-image-bucket
AWS_REGION=ap-south-2
DDB_TABLE=PixelVault

# Flask App Security
SECRET_KEY=change-this-to-a-secure-random-string
COOKIE_SECURE=false

# CloudFront CDN (Optional - leave empty to disable CDN and use direct S3 pre-signed URLs)
CDN_DOMAIN=
CDN_KEY_PAIR_ID=
CDN_KEY_PARAM=/pixelvault/cloudfront-private-key

# User Registration & Quotas
REGISTRATION_OPEN=true
INVITE_CODE=
TRASH_DAYS=30
MAX_UPLOAD_MB=5
MAX_IMAGES_PER_USER=50
MAX_STORAGE_MB_PER_USER=100

# Optional Initial Seed Admin Account
APP_USERNAME=admin
APP_PASSWORD=
