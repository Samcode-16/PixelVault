{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyImagesPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME",
      "Condition": { "StringLike": { "s3:prefix": ["images/*"] } }
    },
    {
      "Sid": "ObjectReadWriteDeleteInImagesPrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR-BUCKET-NAME/images/*"
    }
  ]
}
